<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Deterministic>true</Deterministic>
    <AssemblyName>ZL.Gear.Engine</AssemblyName>
    <RootNamespace>ZL.Gear.Engine</RootNamespace>
    <Description>Gear.NET orchestration engine: workflow execution, scheduling, and industry kit integration.</Description>
    <NoWarn>$(NoWarn);CS8632;CS0067;CS0108;CS0168;CS0162;CA2200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.0.7" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.72.0" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\ZL.Gear.Core\ZL.Gear.Core.csproj" />
    <ProjectReference Include="..\ZL.Gear.Sensing\ZL.Gear.Sensing.csproj" />
  </ItemGroup>
</Project>
