<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <fallbackPackageFolders>
    <!-- 只读复用机器上已有的全局包缓存：受限环境下该目录不可写，但读取正常。 -->
    <add key="global-readonly" value="/Users/dingyuwang/.nuget/packages" />
  </fallbackPackageFolders>

  <config>
    <!-- 新包写入仓库内可写目录，避免触碰只读的全局缓存。 -->
    <add key="globalPackagesFolder" value="./.nuget-packages" />
  </config>
</configuration>
