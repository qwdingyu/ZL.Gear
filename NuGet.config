<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <config>
    <!-- 包缓存写入仓库内目录，避免依赖本机绝对路径（CI / 克隆可复现） -->
    <add key="globalPackagesFolder" value="./.nuget-packages" />
  </config>
</configuration>
