## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2017 auto generated files
Generated\ Files/

# Window's thumbnail cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Mac desktop service store files
.DS_Store

# NuGet
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if you want to ignore NuGet's "packages" folder in the root
# packages/
# !packages/build/
# If you prefer the "packages" folder to be checked in, UNCOMMENT the following line:
# !packages/

# Tooling
_ReSharper*/
*.LCK

# Visual Studio Code
.vscode/

# === 五仓分仓：已迁私有仓，本地联调保留但不入库（ZL.Gear.Docs/167）===
# 公开轨保留 docs/README.md 与公开指南；私有仓编号文档 028-167 不入本仓
docs/*.md
!docs/README.md
!docs/001_*.md
!docs/002_*.md
!docs/003_*.md
!docs/004_*.md
!docs/005_*.md
!docs/006_*.md
!docs/007_*.md
demos/SeatDemo/
demos/InstrumentTest/
tests/ZL.Gear.PerformanceTests/
agent-harness/

PublishOutput/
snapshots/
# === 运行时审计日志（历史跟踪经 git rm --cached 解除，见提交说明）===
logs/audit.log
**/logs/audit.log

# === 基准 / 测试 / 分析生成物 ===
BenchmarkDotNet.Artifacts/
**/TestResults/
__pycache__/
.reasonix/
*.pyc

# === SeatDemo 演示运行结果 ===
demos/SeatDemo/data/results/
demos/SeatDemo/src/SeatDemo.ConsoleApp/snapshots/

# === 运行时生成数据 ===
Data/
Reports/

.tmp/
.serena/
.qwen/
# 闭源 DLL 在 Gear.All/libs/（工作区根，不入本仓）
.qwen/tmp/

# === NuGet 本地缓存（还原用，禁止提交）===
.nuget-packages/
