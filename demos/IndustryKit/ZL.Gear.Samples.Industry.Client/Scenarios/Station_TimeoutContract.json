{
  "StepKey": "Station_TimeoutContract",
  "StepName": "【IndustryKit】超时契约：流程超时不得误 PASS",
  "Description": "对齐 Demo_Timeout_Contract：WorkflowTimeoutMs 取消整链，期望 OverallSuccess=false。",
  "Command": "DynamicFlow",
  "EvaluateResult": false,
  "TimeoutMs": 5000,
  "StopByFail": false,
  "Enable": true,
  "Parameters": {
    "WorkflowTimeoutMs": 800,
    "WorkflowDefinition": {
      "WorkflowTimeoutMs": 800,
      "Finalizers": [
        {
          "Type": "Action",
          "Description": "超时后仍应清理",
          "ActionKey": "Log",
          "Args": { "Message": "[Finally] Station Timeout cleanup" }
        }
      ],
      "Sequence": [
        {
          "Type": "Action",
          "Description": "说明",
          "ActionKey": "Log",
          "Args": { "Message": "即将 Delay 超过 WorkflowTimeoutMs" }
        },
        {
          "Type": "Delay",
          "Description": "故意超过流程超时",
          "DelayMs": 5000
        },
        {
          "Type": "Action",
          "Description": "不应执行到此处",
          "ActionKey": "Log",
          "Args": { "Message": "ERROR: should not reach" }
        }
      ]
    }
  }
}
