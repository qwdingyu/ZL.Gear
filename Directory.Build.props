<Project>
  <PropertyGroup>
    <!-- 统一版本管理（与 Git tag vX.Y.Z / NuGet 对齐） -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors Condition="'$(Authors)' == ''">ZL Gear Contributors</Authors>
    <Company Condition="'$(Company)' == ''">ZL.Gear</Company>
    <Product>ZL.Gear 工业自动化微编排框架</Product>
    <Description Condition="'$(Description)' == '' and '$(PackageId)' != ''">$(PackageId) — Gear.NET framework library.</Description>
    <Copyright>Copyright © 2026 ZL Gear Contributors</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 编译选项 -->
    <LangVersion>11.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 屏蔽不必要的编译警告 -->
    <NoWarn>$(NoWarn);CS0108;NU1603;CS0168;CS8602;CS8604;CS0067;CS8632</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>