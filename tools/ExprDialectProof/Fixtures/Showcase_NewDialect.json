{
  "StepKey": "Proof_Core_Showcase",
  "StepName": "【论证】新方言全量橱窗（对齐 Demo_Core_Showcase 结构）",
  "Description": "docs/133 L0+L1：Calculate 裸标识符；Assert 优先 Check（L1），保留一组 L0；Retry/Parallel/Group/WaitUntil/Delay/Finalizers/${插值}。",
  "Command": "DynamicFlow",
  "EvaluateResult": false,
  "TimeoutMs": 60000,
  "StopByFail": true,
  "Enable": true,
  "Parameters": {
    "WorkflowTimeoutMs": 30000,
    "WorkflowDefinition": {
      "WorkflowTimeoutMs": 30000,
      "Variables": {
        "LimitOhm": 5.0,
        "Ready": false,
        "MaxLeakage": 5.0
      },
      "Finalizers": [
        {
          "Type": "Action",
          "Description": "最终清理（无论成败）",
          "ActionKey": "Log",
          "Args": { "Message": "[Finally] Proof Showcase cleanup" }
        }
      ],
      "Sequence": [
        {
          "Type": "Action",
          "Description": "注入模拟测量值",
          "ActionKey": "SetVariable",
          "Args": { "Key": "MeasuredOhm", "Value": 2.5 }
        },
        {
          "Type": "Action",
          "Description": "计算裕量（裸标识符）",
          "ActionKey": "Calculate",
          "Args": {
            "Expression": "LimitOhm - MeasuredOhm",
            "OutputKey": "Margin"
          }
        },
        {
          "Type": "Action",
          "Description": "L1 Check：裕量为正",
          "ActionKey": "Assert",
          "Args": {
            "Check": "Margin > 0",
            "Message": "电阻裕量不足"
          }
        },
        {
          "Type": "Action",
          "Description": "注入泄漏电流模拟值",
          "ActionKey": "SetVariable",
          "Args": { "Key": "LeakageMa", "Value": 3.0 }
        },
        {
          "Type": "Action",
          "Description": "L1 Check：泄漏上限（变量 vs 变量）",
          "ActionKey": "Assert",
          "Args": {
            "Check": "LeakageMa <= MaxLeakage",
            "Message": "泄漏超限"
          }
        },
        {
          "Type": "Action",
          "Description": "L0 对照：显式 Left/Op/Right（权威形态仍可用）",
          "ActionKey": "Assert",
          "Args": {
            "Left": "Margin",
            "Op": "Gte",
            "Right": 0,
            "Message": "L0 裕量检查失败"
          }
        },
        {
          "Type": "Retry",
          "Description": "瞬时失败可重试的日志探针",
          "ActionKey": "Log",
          "RetryCount": 2,
          "IntervalMs": 20,
          "Args": { "Message": "[Retry] 探针 OK" }
        },
        {
          "Type": "Parallel",
          "Description": "步内并行动作（非测量）",
          "Children": [
            {
              "Type": "Action",
              "Description": "支路 A",
              "ActionKey": "Log",
              "Args": { "Message": "Parallel-A" }
            },
            {
              "Type": "Action",
              "Description": "支路 B",
              "ActionKey": "Log",
              "Args": { "Message": "Parallel-B" }
            }
          ]
        },
        {
          "Type": "Group",
          "Description": "视觉分组（运行时≡Sequence）",
          "Children": [
            {
              "Type": "Action",
              "Description": "标记 Ready",
              "ActionKey": "SetVariable",
              "Args": { "Key": "Ready", "Value": true }
            },
            {
              "Type": "WaitUntil",
              "Description": "轮询变量到位（裸标识符）",
              "Condition": "Ready",
              "TimeoutMs": 2000,
              "IntervalMs": 50
            }
          ]
        },
        {
          "Type": "Delay",
          "Description": "短延时",
          "DelayMs": 30
        },
        {
          "Type": "Action",
          "Description": "橱窗完成",
          "ActionKey": "Log",
          "Args": { "Message": ">>> Proof Showcase PASS；Margin=${Margin} Leak=${LeakageMa}" }
        }
      ]
    }
  }
}
